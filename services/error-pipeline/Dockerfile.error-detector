FROM --platform=$BUILDPLATFORM golang:1.26.9-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./
COPY cmd/ cmd/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-w -s" \
    -o /bin/error-detector \
    ./cmd/error-detector

FROM gcr.io/distroless/static:nonroot

WORKDIR /
COPY --from=builder /bin/error-detector /error-detector

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/error-detector"]
