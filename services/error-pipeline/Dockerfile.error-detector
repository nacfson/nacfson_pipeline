# Multi-stage Dockerfile for the error detector (error-detector)
# Supports both linux/amd64 and linux/arm64 architectures

FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod ./
COPY cmd/ cmd/
COPY internal/ internal/

# Build statically linked binary (Go 1.22 stdlib only)
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-w -s" \
    -o /bin/error-detector \
    ./cmd/error-detector

# Production runtime image: unprivileged non-root distroless
FROM gcr.io/distroless/static:nonroot

WORKDIR /
COPY --from=builder /bin/error-detector /error-detector

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/error-detector"]
