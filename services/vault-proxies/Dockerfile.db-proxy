FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod ./
COPY cmd/ cmd/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-w -s" \
    -o /bin/vault-db-proxy \
    ./cmd/db-proxy

FROM gcr.io/distroless/static:nonroot

WORKDIR /
COPY --from=builder /bin/vault-db-proxy /vault-db-proxy

USER 65532:65532

EXPOSE 5432 8080

ENTRYPOINT ["/vault-db-proxy"]
