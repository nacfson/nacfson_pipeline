# Multi-stage Dockerfile for Vault Registry Pull Proxy
# Supports both linux/amd64 and linux/arm64 architectures

FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod ./
COPY cmd/ cmd/

# Build statically linked binary
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-w -s" \
    -o /bin/vault-registry-proxy \
    ./cmd/registry-proxy

# Production runtime image: unprivileged non-root distroless
FROM gcr.io/distroless/static:nonroot

WORKDIR /
COPY --from=builder /bin/vault-registry-proxy /vault-registry-proxy

USER 65532:65532

EXPOSE 5000

ENTRYPOINT ["/vault-registry-proxy"]
