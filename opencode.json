{
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "X-MCP-Toolsets": "context,issues"
        }
      },
      "nacfson-debug": {
        "type": "local",
        "command": [
          "/usr/local/bin/nacfson-mcp",
          "--connect",
          "/run/nacfson-mcp/mcp.sock"
        ]
      }
    }
  }
}