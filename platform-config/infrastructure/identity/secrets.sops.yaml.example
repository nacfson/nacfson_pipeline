# Example only. Encrypt real values with sops before committing as *.sops.yaml.
# Private key material must never enter Git.
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-bootstrap-admin
  namespace: identity-system
type: Opaque
stringData:
  username: ENC[AES256_GCM,data:placeholder,iv:placeholder,tag:placeholder,type:str]
  password: ENC[AES256_GCM,data:placeholder,iv:placeholder,tag:placeholder,type:str]
sops:
  age:
    - recipient: age1platformreplacementpubkeyplaceholder000000000000000000000000000
      enc: |
        -----BEGIN AGE ENCRYPTED FILE-----
        YWdlLWVuY3J5cHRpb24ub3JnL3YxCi0+IHNjcnlwdCB0aGlzaXNub3RyZWFsCi0tLSB0aGlzaXNub3RyZWFs
        -----END AGE ENCRYPTED FILE-----
  lastmodified: "2026-09-19T00:00:00Z"
  mac: ENC[AES256_GCM,data:placeholder,iv:placeholder,tag:placeholder,type:str]
  encrypted_regex: ^(data|stringData)$
  version: 3.9.0
---
