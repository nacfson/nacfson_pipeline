{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://platform.processmanager.dev/schemas/source-build-v1.json",
  "title": "SourceBuildContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "builder",
    "context",
    "dockerfile",
    "testTarget",
    "runtimeTarget",
    "platforms"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "builder": {
      "type": "string",
      "const": "dockerfile"
    },
    "context": {
      "type": "string",
      "pattern": "^(?!/|.*\\.\\.).+$"
    },
    "dockerfile": {
      "type": "string",
      "pattern": "^(?!/|.*\\.\\.).+$"
    },
    "testTarget": {
      "type": "string",
      "minLength": 1
    },
    "runtimeTarget": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "linux/amd64"
      },
      "uniqueItems": true
    }
  }
}
