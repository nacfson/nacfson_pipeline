apiVersion: cert-manager.io/v1
kind: CertificateRequest
metadata:
  generateName: {{ inventory_hostname }}-{{ certs_identity }}-
  namespace: {{ kafka_runner_namespace }}
  labels:
    oci-link.nacfson.io/vm: {{ inventory_hostname }}
    oci-link.nacfson.io/identity: {{ certs_identity }}
spec:
  request: {{ certs_csr.csr | b64encode }}
  duration: {{ kafka_cert_duration }}
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: {{ kafka_ca_issuer }}
  usages:
    - digital signature
    - client auth
{% if certs_identity is match('^(broker|controller)-') %}
    - server auth
{% endif %}
