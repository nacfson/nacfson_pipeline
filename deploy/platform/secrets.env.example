# ==============================================================================
# Platform Operator Secrets Template (EXAMPLE ONLY - NEVER COMMIT REAL VALUES)
# ==============================================================================

# Google Identity Brokering (Keycloak)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL Shared Database Credentials
POSTGRES_ADMIN_PASSWORD=change-me-to-a-secure-postgres-admin-password
KEYCLOAK_DB_PASSWORD=change-me-to-a-secure-keycloak-db-password
PROJ_PN_DB_PASSWORD=change-me-to-a-secure-project-pn-db-password

# Keycloak Administration & Service Clients
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-to-a-secure-keycloak-admin-password
SESSION_REVOCATION_CLIENT_SECRET=change-me-to-session-revocation-client-secret
PROJECT_PN_CLIENT_SECRET=change-me-to-project-pn-client-secret

# Gateway State & Cookie Encryption Key (32-byte hex string)
GATEWAY_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Private GitHub Container Registry (GHCR) Access Token
GHCR_PULL_TOKEN=<YOUR_GITHUB_PACKAGES_PAT>
GHCR_USERNAME=nacfson
