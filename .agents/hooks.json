{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 scripts/universal-agent-hook.py --agent antigravity --event SessionStart",
        "timeout": 20
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/universal-agent-hook.py --agent antigravity --event PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/universal-agent-hook.py --agent antigravity --event Stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
